# Copy to backend/.env. Every behaviour below can be changed without touching code.
# Wazuh credentials stay on the server and are never sent to the browser.

# --- modes and flags (defaults keep the replay demo unchanged) ---
# replay | wazuh. "wazuh" switches ingest to the indexer; replayed alerts stay simulated.
ALERT_SOURCE=replay
# 1 shows the Reword toggle and enables /alerts/{id}/reword
AI_REWORD=0
# 1 enables proposals, approval cards and /actions, /devices, /clinic/standing-rule
# The one-tap "Block ..." button on a staff phone's attack notification also needs ACTIONS=1
# (with it off, the note arrives with no button).
ACTIONS=0

# --- server ---
DB_PATH=backend/shieldmate.db
PORT=8000

# --- optional owner PIN (decision 3: off for now) ---
# Leave both unset to run without a PIN. When set, owner routes need X-Owner-Pin
# and /demo/* needs the backstage token.
OWNER_PIN=
BACKSTAGE_TOKEN=

# --- restore check ---
RESTORE_BACKUP_DIR=backend/demo_backup/backup
RESTORE_MANIFEST=backend/demo_backup/originals/manifest.json
RESTORE_SANDBOX_DIR=backend/restore_sandbox

# --- Wazuh (live mode only) ---
WAZUH_API_URL=
WAZUH_API_USER=
WAZUH_API_PASSWORD=
WAZUH_INDEXER_URL=
WAZUH_INDEXER_USER=
WAZUH_INDEXER_PASSWORD=
# Path to the lab's root-ca.pem. Never turn verification off.
WAZUH_CA_CERT=
# Active-response command name = "netsh" + timeout in seconds (decision 10).
# Use netsh120 for the 2-minute expiry test (T5.06).
WAZUH_AR_COMMAND=netsh3600
WAZUH_TIMEOUT_SECONDS=5

# --- AI reword provider: none = pre-written fallback wording ---
AI_PROVIDER=none

# --- AI interpreter (the n8n agent that explains tasks in plain language) ---
# 1 enables POST /interpreter/chat, proxied to the n8n webhook. With the flag on but no URL,
# every chat answers with the pre-written fallback instead of the agent.
AI_INTERPRETER=0
# The n8n webhook URL (https only; a server-side secret, never sent to the browser).
AI_INTERPRETER_URL=
# Seconds to wait for the agent before falling back to the plain version.
AI_INTERPRETER_TIMEOUT_SECONDS=30

# --- event log (eventlog/): everything that happens, kept for later analysis ---
# On by default; 0 turns it off (and POST /api/events answers not_enabled).
EVENT_LOG=1
# Its own SQLite file, never wiped by Reset. Empty = next to DB_PATH (backend/shieldmate-events.db).
EVENTS_DB_PATH=
# 1 also logs successful GETs. The phones poll every 2 s, so this is very noisy.
EVENT_LOG_READS=0

# --- clinic seed (relative to the repo root; default backend/seed/clinic.json) ---
# Point at the lab copy when running against the real Wazuh lab (agent IDs and never-block IPs):
# SEED_PATH=backend/seed/clinic.lab.json
