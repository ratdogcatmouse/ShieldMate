# Copy to backend/.env and fill in. Never commit .env (it holds the Wazuh passwords).
# Leave ALERT_SOURCE=replay to run the demo on Backstage replays only.
ALERT_SOURCE=replay            # replay | wazuh
ACTIONS=on                     # on = approved blocks are sent to Wazuh; off = recorded only (simulated)

WAZUH_API_URL=https://192.168.137.20:55000
WAZUH_API_USER=shieldmate
WAZUH_API_PASSWORD=
WAZUH_INDEXER_URL=https://192.168.137.20:9200
WAZUH_INDEXER_USER=shieldmate_reader
WAZUH_INDEXER_PASSWORD=
WAZUH_VERIFY_TLS=false         # lab only: self-signed certificates
WAZUH_BLOCK_COMMAND=!shieldmate-block.exe   # Plan B; or !netsh.exe for Plan A (no early delete)
WAZUH_POLL_SECONDS=5
NEVER_BLOCK=192.168.137.1,192.168.137.20    # hotspot gateway, Wazuh server; add the laptop's own IP

# Rule 60204's settings in your Wazuh rule file (0580-win-security_rules.xml), used for the card's numbers
WAZUH_60204_FREQUENCY=8
WAZUH_60204_TIMEFRAME=240      # seconds
